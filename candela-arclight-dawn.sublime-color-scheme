{
  "name": "Candela Arclight Dawn",
  "author": "Candela",
  "variables": {
    "bg": "#f3f4f5",
    "surface": "#fcfcfd",
    "border": "#d5d8db",
    "ink": "#191c20",
    "ink2": "#3f454b",
    "faint": "#686f75",
    "selection": "#dde1e4",
    "cursor": "#191c20",
    "lineHighlight": "#eaecee",
    "kw": "#7a1f4d",
    "str": "#1f6b3a",
    "fn": "#0c2650",
    "num": "#8a5112",
    "type": "#5a2f8a",
    "builtin": "#0f5f6b",
    "punct": "#565d64",
    "error": "#9a3627",
    "warning": "#7b661e",
    "ok": "#247b57",
    "--background": "var(bg)",
    "--foreground": "var(ink)",
    "--accent": "var(builtin)",
    "--redish": "var(error)",
    "--orangish": "var(warning)",
    "--greenish": "var(ok)",
    "--bluish": "var(fn)"
  },
  "globals": {
    "background": "var(surface)",
    "foreground": "var(ink)",
    "caret": "var(cursor)",
    "line_highlight": "var(lineHighlight)",
    "selection": "var(selection)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(ink2)",
    "invisibles": "var(faint)",
    "accent": "var(builtin)"
  },
  "rules": [
    {
      "scope": "keyword, storage",
      "foreground": "var(kw)"
    },
    {
      "scope": "string",
      "foreground": "var(str)"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "var(fn)"
    },
    {
      "scope": "constant.numeric, constant.language",
      "foreground": "var(num)"
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "foreground": "var(type)"
    },
    {
      "scope": "support, variable.language, constant.other.symbol",
      "foreground": "var(builtin)"
    },
    {
      "scope": "punctuation, keyword.operator",
      "foreground": "var(punct)"
    },
    {
      "scope": "comment",
      "foreground": "var(faint)",
      "font_style": "italic"
    },
    {
      "scope": "entity.name.tag, entity.name.namespace",
      "foreground": "var(type)"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "var(builtin)"
    },
    {
      "scope": "constant.character.escape",
      "foreground": "var(num)"
    },
    {
      "scope": "invalid",
      "foreground": "var(error)"
    },
    {
      "scope": "markup.heading, entity.name.section",
      "foreground": "var(fn)",
      "font_style": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "var(kw)",
      "font_style": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "var(kw)",
      "font_style": "italic"
    },
    {
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "var(builtin)"
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "foreground": "var(fn)",
      "font_style": "underline"
    },
    {
      "scope": "markup.quote",
      "foreground": "var(faint)",
      "font_style": "italic"
    },
    {
      "scope": "markup.inserted",
      "foreground": "var(ok)"
    },
    {
      "scope": "markup.deleted",
      "foreground": "var(error)"
    },
    {
      "scope": "markup.changed",
      "foreground": "var(warning)"
    }
  ]
}
