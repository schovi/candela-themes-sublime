{
  "name": "Candela Blue Hour",
  "author": "Candela",
  "variables": {
    "bg": "#1a1b26",
    "surface": "#20222f",
    "border": "#3b4261",
    "ink": "#c3cbe8",
    "ink2": "#7d87ad",
    "faint": "#8890b4",
    "selection": "#33395a",
    "cursor": "#ff9e64",
    "lineHighlight": "#24263a",
    "kw": "#bda6f0",
    "str": "#a4c98c",
    "fn": "#7fa0f0",
    "num": "#f0a878",
    "type": "#7fd3d8",
    "builtin": "#dcc471",
    "punct": "#c3cbe8",
    "error": "#ef6a83",
    "warning": "#e8b25f",
    "ok": "#6fd0bb",
    "--background": "var(bg)",
    "--foreground": "var(ink)",
    "--accent": "var(builtin)",
    "--redish": "var(error)",
    "--orangish": "var(warning)",
    "--greenish": "var(ok)",
    "--bluish": "var(fn)"
  },
  "globals": {
    "background": "var(surface)",
    "foreground": "var(ink)",
    "caret": "var(cursor)",
    "line_highlight": "var(lineHighlight)",
    "selection": "var(selection)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(ink2)",
    "invisibles": "var(faint)",
    "accent": "var(builtin)"
  },
  "rules": [
    {
      "scope": "keyword, storage",
      "foreground": "var(kw)"
    },
    {
      "scope": "string",
      "foreground": "var(str)"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "var(fn)"
    },
    {
      "scope": "constant.numeric, constant.language",
      "foreground": "var(num)"
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "foreground": "var(type)"
    },
    {
      "scope": "support, variable.language, constant.other.symbol",
      "foreground": "var(builtin)"
    },
    {
      "scope": "punctuation, keyword.operator",
      "foreground": "var(punct)"
    },
    {
      "scope": "comment",
      "foreground": "var(faint)",
      "font_style": "italic"
    }
  ]
}
