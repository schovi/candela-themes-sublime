{
  "name": "Candela Hearth Dusk",
  "author": "Candela",
  "variables": {
    "bg": "#241c17",
    "surface": "#2c231c",
    "border": "#4e3f31",
    "ink": "#e8d6bc",
    "ink2": "#a89279",
    "faint": "#a08b70",
    "selection": "#453527",
    "cursor": "#f0a13c",
    "lineHighlight": "#2e241c",
    "kw": "#f0a05a",
    "str": "#c6c05e",
    "fn": "#e8c88c",
    "num": "#dd7f5e",
    "type": "#cf9a86",
    "builtin": "#a8c47a",
    "punct": "#e8d6bc",
    "error": "#f2705f",
    "warning": "#dbae4a",
    "ok": "#8ac9a0",
    "--background": "var(bg)",
    "--foreground": "var(ink)",
    "--accent": "var(builtin)",
    "--redish": "var(error)",
    "--orangish": "var(warning)",
    "--greenish": "var(ok)",
    "--bluish": "var(builtin)"
  },
  "globals": {
    "background": "var(surface)",
    "foreground": "var(ink)",
    "caret": "var(cursor)",
    "line_highlight": "var(lineHighlight)",
    "selection": "var(selection)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(ink2)",
    "invisibles": "var(faint)",
    "accent": "var(builtin)"
  },
  "rules": [
    {
      "scope": "keyword, storage",
      "foreground": "var(kw)"
    },
    {
      "scope": "string",
      "foreground": "var(str)"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "var(fn)"
    },
    {
      "scope": "constant.numeric, constant.language",
      "foreground": "var(num)"
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "foreground": "var(type)"
    },
    {
      "scope": "support, variable.language, constant.other.symbol",
      "foreground": "var(builtin)"
    },
    {
      "scope": "punctuation, keyword.operator",
      "foreground": "var(punct)"
    },
    {
      "scope": "comment",
      "foreground": "var(faint)",
      "font_style": "italic"
    }
  ]
}
