{
  "name": "Candela 24 · Azure Mono",
  "author": "Candela",
  "variables": {
    "bg": "#181a1c",
    "surface": "#202224",
    "border": "#424547",
    "ink": "#d6dade",
    "ink2": "#8e9296",
    "faint": "#8b8f93",
    "selection": "#353a3e",
    "cursor": "#e8b45c",
    "lineHighlight": "#1e2022",
    "kw": "#78b4e8",
    "str": "#a8d0ee",
    "fn": "#b0b6bb",
    "num": "#a0a6ab",
    "type": "#c4cacf",
    "builtin": "#78b4e8",
    "punct": "#d6dade",
    "error": "#d8806f",
    "warning": "#cbb26c",
    "ok": "#8ac4b0",
    "--background": "var(bg)",
    "--foreground": "var(ink)",
    "--accent": "var(builtin)",
    "--redish": "var(error)",
    "--orangish": "var(warning)",
    "--greenish": "var(ok)",
    "--bluish": "var(kw)"
  },
  "globals": {
    "background": "var(surface)",
    "foreground": "var(ink)",
    "caret": "var(cursor)",
    "line_highlight": "var(lineHighlight)",
    "selection": "var(selection)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(ink2)",
    "invisibles": "var(faint)",
    "accent": "var(builtin)"
  },
  "rules": [
    {
      "scope": "keyword, storage",
      "foreground": "var(kw)"
    },
    {
      "scope": "string",
      "foreground": "var(str)"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "var(fn)"
    },
    {
      "scope": "constant.numeric, constant.language",
      "foreground": "var(num)"
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "foreground": "var(type)"
    },
    {
      "scope": "support, variable.language, constant.other.symbol",
      "foreground": "var(builtin)"
    },
    {
      "scope": "punctuation, keyword.operator",
      "foreground": "var(punct)"
    },
    {
      "scope": "comment",
      "foreground": "var(faint)",
      "font_style": "italic"
    }
  ]
}
