{
  "name": "Candela Moss & Magenta",
  "author": "Candela",
  "variables": {
    "bg": "#262720",
    "surface": "#2e2f27",
    "border": "#565749",
    "ink": "#e0e0d4",
    "ink2": "#97988a",
    "faint": "#9d9e8f",
    "selection": "#46483a",
    "cursor": "#f08a2e",
    "lineHighlight": "#2f3128",
    "kw": "#f0709e",
    "str": "#d9d087",
    "fn": "#a9d364",
    "num": "#b79ef0",
    "type": "#79cbe0",
    "builtin": "#f0a352",
    "punct": "#e0e0d4",
    "error": "#ff6a70",
    "warning": "#e9bc4c",
    "ok": "#5fc9a5",
    "--background": "var(bg)",
    "--foreground": "var(ink)",
    "--accent": "var(builtin)",
    "--redish": "var(error)",
    "--orangish": "var(warning)",
    "--greenish": "var(ok)",
    "--bluish": "var(type)"
  },
  "globals": {
    "background": "var(surface)",
    "foreground": "var(ink)",
    "caret": "var(cursor)",
    "line_highlight": "var(lineHighlight)",
    "selection": "var(selection)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(ink2)",
    "invisibles": "var(faint)",
    "accent": "var(builtin)"
  },
  "rules": [
    {
      "scope": "keyword, storage",
      "foreground": "var(kw)"
    },
    {
      "scope": "string",
      "foreground": "var(str)"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "var(fn)"
    },
    {
      "scope": "constant.numeric, constant.language",
      "foreground": "var(num)"
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "foreground": "var(type)"
    },
    {
      "scope": "support, variable.language, constant.other.symbol",
      "foreground": "var(builtin)"
    },
    {
      "scope": "punctuation, keyword.operator",
      "foreground": "var(punct)"
    },
    {
      "scope": "comment",
      "foreground": "var(faint)",
      "font_style": "italic"
    },
    {
      "scope": "entity.name.tag, entity.name.namespace",
      "foreground": "var(type)"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "var(builtin)"
    },
    {
      "scope": "constant.character.escape",
      "foreground": "var(num)"
    },
    {
      "scope": "invalid",
      "foreground": "var(error)"
    },
    {
      "scope": "markup.heading, entity.name.section",
      "foreground": "var(fn)",
      "font_style": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "var(kw)",
      "font_style": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "var(kw)",
      "font_style": "italic"
    },
    {
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "var(builtin)"
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "foreground": "var(fn)",
      "font_style": "underline"
    },
    {
      "scope": "markup.quote",
      "foreground": "var(faint)",
      "font_style": "italic"
    },
    {
      "scope": "markup.inserted",
      "foreground": "var(ok)"
    },
    {
      "scope": "markup.deleted",
      "foreground": "var(error)"
    },
    {
      "scope": "markup.changed",
      "foreground": "var(warning)"
    }
  ]
}
